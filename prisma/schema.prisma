generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                       @id @default(cuid())
  email                      String                       @unique
  password                   String
  name                       String
  createdAt                  DateTime                     @default(now())
  expenses                   Expense[]
  budgets                    Budget[]
  incomes                    Income[]
  accounts                   Account[]
  creditCards                CreditCard[]
  installmentPlans           InstallmentPlan[]
  recurringPayments          RecurringPayment[]
  recurringPaymentOccurrences RecurringPaymentOccurrence[]
}

enum AccountType {
  BANK
  CASH
  SAVINGS
  VOUCHER
  OTHER
}

enum InstallmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RecurringPaymentType {
  RENT
  SERVICE
  MAINTENANCE
  SUBSCRIPTION
  OTHER
}

enum RecurringPaymentStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum RecurringPaymentOccurrenceStatus {
  PENDING
  PAID
  SKIPPED
  OVERDUE
}

enum IncomeSource {
  NOMINA
  FACTURA
  OTRO
}

model Account {
  id             String      @id @default(cuid())
  name           String
  type           AccountType @default(BANK)
  currentBalance Float
  notes          String?
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
}

model CreditCard {
  id               String            @id @default(cuid())
  name             String
  currentBalance   Float
  creditLimit      Float?
  cutoffDay        Int
  dueDay           Int
  minimumPayment   Float?
  notes            String?
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  installmentPlans InstallmentPlan[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
}

model Category {
  id                String             @id @default(cuid())
  name              String             @unique
  icon              String             @default("tag")
  color             String             @default("#6366f1")
  expenses          Expense[]
  budgets           Budget[]
  installmentPlans  InstallmentPlan[]
  recurringPayments RecurringPayment[]
}

model InstallmentPlan {
  id                String            @id @default(cuid())
  description       String
  totalAmount       Float
  installmentCount  Int
  installmentAmount Float
  startMonth        Int
  startYear         Int
  status            InstallmentStatus @default(ACTIVE)
  notes             String?
  userId            String
  creditCardId      String
  categoryId        String?
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard        CreditCard        @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  category          Category?         @relation(fields: [categoryId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([creditCardId])
  @@index([categoryId])
}

model RecurringPayment {
  id          String                 @id @default(cuid())
  description String
  amount      Float
  type        RecurringPaymentType   @default(OTHER)
  dueDay      Int
  startMonth  Int
  startYear   Int
  endMonth    Int?
  endYear     Int?
  status      RecurringPaymentStatus @default(ACTIVE)
  notes       String?
  userId      String
  categoryId  String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category               @relation(fields: [categoryId], references: [id])
  occurrences RecurringPaymentOccurrence[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([userId])
  @@index([categoryId])
}

model RecurringPaymentOccurrence {
  id                 String                           @id @default(cuid())
  recurringPaymentId String
  userId             String
  month              Int
  year               Int
  amount             Float
  dueDate            DateTime
  status             RecurringPaymentOccurrenceStatus @default(PENDING)
  paidAt             DateTime?
  expenseId          String?                          @unique
  recurringPayment   RecurringPayment                 @relation(fields: [recurringPaymentId], references: [id], onDelete: Cascade)
  user               User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense            Expense?                         @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  @@unique([recurringPaymentId, month, year])
  @@index([userId, year, month])
  @@index([recurringPaymentId])
  @@index([expenseId])
}

model Expense {
  id                         String                      @id @default(cuid())
  amount                     Float
  description                String
  date                       DateTime                    @default(now())
  receipt                    String?
  ocrText                    String?
  receiptData                Json?
  userId                     String
  categoryId                 String
  user                       User                        @relation(fields: [userId], references: [id])
  category                   Category                    @relation(fields: [categoryId], references: [id])
  recurringPaymentOccurrence RecurringPaymentOccurrence?
  createdAt                  DateTime                    @default(now())
}

model Budget {
  id         String   @id @default(cuid())
  amount     Float
  month      Int
  year       Int
  userId     String
  categoryId String
  user       User     @relation(fields: [userId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId, month, year])
}

model Income {
  id          String       @id @default(cuid())
  amount      Float
  bankDeposit Float
  despensa    Float        @default(0)
  description String
  source      IncomeSource @default(OTRO)
  date        DateTime     @default(now())
  periodStart DateTime?
  periodEnd   DateTime?
  cfdiUuid    String?      @unique
  cfdiXml     String?      @db.Text
  employer    String?
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([userId, date])
}
