generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  createdAt DateTime  @default(now())
  expenses  Expense[]
  budgets   Budget[]
  incomes   Income[]
}

enum IncomeSource {
  NOMINA
  FACTURA
  OTRO
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  icon     String    @default("tag")
  color    String    @default("#6366f1")
  expenses Expense[]
  budgets  Budget[]
}

model Expense {
  id          String   @id @default(cuid())
  amount      Float
  description String
  date        DateTime @default(now())
  receipt     String?
  ocrText     String?
  userId      String
  categoryId  String
  user        User     @relation(fields: [userId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
}

model Budget {
  id         String   @id @default(cuid())
  amount     Float
  month      Int
  year       Int
  userId     String
  categoryId String
  user       User     @relation(fields: [userId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId, month, year])
}

model Income {
  id          String       @id @default(cuid())
  amount      Float
  bankDeposit Float
  despensa    Float        @default(0)
  description String
  source      IncomeSource @default(OTRO)
  date        DateTime     @default(now())
  periodStart DateTime?
  periodEnd   DateTime?
  cfdiUuid    String?      @unique
  cfdiXml     String?      @db.Text
  employer    String?
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([userId, date])
}
